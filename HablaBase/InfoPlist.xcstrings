{
  "sourceLanguage": "en",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HablaBase listens while you say Spanish sentences aloud, to check your pronunciation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HablaBase ti ascolta mentre dici frasi in spagnolo ad alta voce, per controllare la tua pronuncia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "HablaBase слухає, як ти вимовляєш іспанські речення вголос, щоб перевірити вимову."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HablaBase hört zu, während du spanische Sätze laut sprichst, um deine Aussprache zu prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HablaBase t'écoute quand tu dis des phrases en espagnol à voix haute, pour vérifier ta prononciation."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O HablaBase escuta enquanto você diz frases em espanhol em voz alta, para verificar sua pronúncia."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HablaBase turns what you say in Spanish into text to check your sentence. When your iPhone supports it, this happens on the phone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HablaBase trasforma in testo quello che dici in spagnolo per controllare la tua frase. Se il tuo iPhone lo supporta, avviene sul telefono."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "HablaBase перетворює сказане іспанською на текст, щоб перевірити твоє речення. Якщо твій iPhone це підтримує, усе відбувається на телефоні."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HablaBase wandelt das, was du auf Spanisch sagst, in Text um, um deinen Satz zu prüfen. Wenn dein iPhone es unterstützt, geschieht das direkt auf dem Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HablaBase transcrit ce que tu dis en espagnol pour vérifier ta phrase. Si ton iPhone le permet, cela se fait directement sur l'appareil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O HablaBase transforma o que você diz em espanhol em texto para verificar sua frase. Quando o seu iPhone permite, isso acontece no próprio aparelho."
          }
        }
      }
    }
  },
  "version": "1.0"
}
