    "Almost. Listen again and try the orange words.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quasi. Ascolta di nuovo e riprova le parole in arancione."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Майже. Послухай ще раз і повтори помаранчеві слова."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast. Hör noch mal hin und übe die orangefarbenen Wörter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Presque. Réécoute et retente les mots en orange."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quase. Ouça de novo e tente as palavras em laranja."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "差一点。再听一遍，重说橙色的词。"
          }
        }
      }
    },
